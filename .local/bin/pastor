#!/usr/bin/env bash
# pastor was renamed operator in 2.0. This alias keeps old jobs, the foreman
# and muscle memory working until `operator migrate` has run everywhere.
s="${BASH_SOURCE[0]}"
while [ -L "$s" ]; do
  t="$(readlink "$s")"
  case "$t" in /*) s="$t" ;; *) s="$(cd "$(dirname "$s")" && pwd)/$t" ;; esac
done
exec "$(cd "$(dirname "$s")" && pwd)/operator" "$@"
